<link href="{{ 'ymm-filter.css' | asset_url }}" rel="stylesheet" type="text/css">

<div class="ymm-filter">
  <label class="ymm-title">Search for Parts That Fit Your Vehicle</label>

  <!-- VIN Search -->
  <div class="ymm-inner-filter">
    <input type="text" id="vin-input" placeholder="Enter VIN" class="vin-input" maxlength="17">
    <button id="vin-search-btn" class="vin-search-button" onclick="searchByVin()">Search by VIN</button>
     <label onclick="toggleManualSearch()" style="color: blue; cursor: pointer; margin-left: 12px; white-space: nowrap;">
    Search Manually
  </label>
  </div>
  <div id="vin-error" class="ymm-error-message"></div>

  <!-- VIN Result Display -->
  <div id="vin-vehicle-info" class="ymm-inner-filter" style="display: none; margin-top: 16px;"></div>

  <!-- VIN-based editable form -->
<div class="ymm-inner-filter" id="vin-form" style="display: none; margin-top: 16px; flex-direction: column; gap: 12px;">
  <div class="field-wrapper">
    <input type="text" id="vin-make" class="ymm-dropdown" placeholder="Make">
  </div>
  <div class="field-wrapper">
    <input type="text" id="vin-model" class="ymm-dropdown" placeholder="Model">
  </div>
  <div class="field-wrapper">
    <input type="text" id="vin-year" class="ymm-dropdown" placeholder="Year">
  </div>
  <div class="field-wrapper">
    <input type="text" id="vin-engine" class="ymm-dropdown" placeholder="Engine Type (e.g. 2.5L)">
  </div>
  <div class="field-wrapper">
    <input type="text" id="vin-drive" class="ymm-dropdown" placeholder="Drive Type (e.g. AWD)">
  </div>

  <!-- Search Button -->
<button id="vin-form-search-btn" class="vin-search-button" onclick="handleVinFormSearch()">Search</button>
</div>



  <!-- YMM Search Dropdown Form (hidden by default) -->
  <div class="ymm-inner-filter" id="ymm-section" style="display: none; margin-top: 16px;">
    <div class="field-wrapper">
      <select id="ymm-make" class="ymm-dropdown">
        <option value="">- Make -</option>
      </select>
      <div id="make-error" class="ymm-error-message"></div>
    </div>

    <div class="field-wrapper">
      <select id="ymm-model" class="ymm-dropdown">
        <option value="">- Model -</option>
      </select>
      <div id="model-error" class="ymm-error-message"></div>
    </div>

    <div class="field-wrapper">
      <select id="ymm-year" class="ymm-dropdown">
        <option value="">- Year -</option>
        {% for i in (2000..2025) %}
        <option value="{{ i }}">{{ i }}</option>
        {% endfor %}
      </select>
      <div id="year-error" class="ymm-error-message"></div>
    </div>

    <div class="field-wrapper">
      <input type="text" id="ymm-engine" class="ymm-dropdown" placeholder="Enter Engine Type (e.g. 2.5L)">
      <div id="engine-error" class="ymm-error-message"></div>
    </div>

    <div class="field-wrapper">
      <select id="ymm-drive" class="ymm-dropdown">
        <option value="">- Drive Type -</option>
        <option value="AWD">AWD</option>
        <option value="FWD">FWD</option>
        <option value="RWD">RWD</option>
      </select>
      <div id="drive-error" class="ymm-error-message"></div>
    </div>

    <button id="ymm-search-btn" class="ymm-search-button" onclick="handleSearch()">Search</button>
  </div>
</div>

<script>
  const APP_BASE_url = "https://epartsmaster-app.vercel.app";
  let ymmData = {};

  function clearAllErrors() {
    ['vin-error', 'make-error', 'model-error', 'year-error', 'drive-error', 'engine-error'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.textContent = '';
        el.classList.remove('has-error');
      }
    });
  }

  function showError(id, message) {
    const el = document.getElementById(id);
    if (el) {
      el.textContent = message;
      el.classList.add('has-error');
    }
  }

  function setLoading(buttonId, loading) {
    const button = document.getElementById(buttonId);
    if (!button) return;
    button.disabled = loading;
    button.textContent = loading ? 'Searching...' : 'Search';
  }

  function toggleManualSearch() {
    const section = document.getElementById('ymm-section');
    section.style.display = 'flex';
    section.style.flexDirection = 'row';

  }

  async function checkProductTagExists(tag) {
    const shop = "{{ shop.permanent_domain | remove: 'https://' }}";
    try {
      const response = await fetch(`${APP_BASE_url}/api/check-tag-exist?tag=${tag}&shop=${shop}`);
      const json = await response.json();
      return json.exists === true;
    } catch (err) {
      console.error("Tag check failed:", err);
      return false;
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    const makeSelect = document.getElementById("ymm-make");
    const modelSelect = document.getElementById("ymm-model");
    const yearSelect = document.getElementById("ymm-year");

    try {
      const res = await fetch(`${APP_BASE_url}/api/make-model`);
      const data = await res.json();

      makeSelect.innerHTML = '<option value="">- Make -</option>';
      data.makes.forEach((make) => {
        ymmData[make.name] = make.models.map((model) => model.name);
        makeSelect.innerHTML += `<option value="${make.name}">${make.name}</option>`;
      });
    } catch (error) {
      console.error("Error fetching vehicle data:", error);
    }

    makeSelect.addEventListener("change", () => {
      clearAllErrors();
      const selectedMake = makeSelect.value;
      modelSelect.innerHTML = '<option value="">- Model -</option>';
      modelSelect.disabled = true;
      yearSelect.disabled = true;
      document.getElementById("ymm-drive").disabled = true;
      document.getElementById("ymm-engine").disabled = true;

      if (!selectedMake || !ymmData[selectedMake]) return;

      ymmData[selectedMake].forEach((model) => {
        modelSelect.innerHTML += `<option value="${model}">${model}</option>`;
      });

      modelSelect.disabled = false;
    });

    modelSelect.addEventListener("change", () => {
      clearAllErrors();
      const enabled = !!modelSelect.value;
      yearSelect.disabled = !enabled;
      document.getElementById("ymm-drive").disabled = !enabled;
      document.getElementById("ymm-engine").disabled = !enabled;
    });

    document.getElementById("vin-input").addEventListener("input", clearAllErrors);
  });
window.handleVinFormSearch = async function () {
  clearAllErrors();
  setLoading('vin-form-search-btn', true);

  const make = document.getElementById('vin-make').value.trim().toLowerCase();
  const model = document.getElementById('vin-model').value.trim().toLowerCase().replace(/\s+/g, '-');
  const year = document.getElementById('vin-year').value.trim();
  const drive = document.getElementById('vin-drive').value.trim().toLowerCase();
  const engine = document.getElementById('vin-engine').value.trim().toLowerCase();
  const defaultCollection = "{{ section.settings.default_collection | default: 'all' }}";

  let hasError = false;
  if (!make) { showError("vin-error", "Make is required."); hasError = true; }
  if (!model) { showError("vin-error", "Model is required."); hasError = true; }
  if (!year) { showError("vin-error", "Year is required."); hasError = true; }

  if (hasError) {
    setLoading('vin-form-search-btn', false);
    return;
  }

  let tag = `eps-${make}-${model}`;
  if (drive) tag += `-${drive}`;
  tag += `-${year}`;
  if (engine) tag += `-${engine.replace(/\./g, 'o')}`;

  const exists = await checkProductTagExists(tag);
  if (exists) {
    window.location.href = `/collections/${defaultCollection}/${tag}`;
  } else {
    showError("vin-error", "No products found.");
  }

  setLoading('vin-form-search-btn', false);
};
  window.searchByVin = async function () {
    clearAllErrors();
    setLoading('vin-search-btn', true);

    const vin = document.getElementById("vin-input").value.trim().toUpperCase();

    if (!vin || vin.length !== 17) {
      showError("vin-error", "Please enter a valid 17-character VIN.");
      setLoading('vin-search-btn', false);
      return;
    }

    try {
      const response = await fetch(`${APP_BASE_url}/api/decode-vin?vin=${vin}`);
      const { vehicle: gptSummary } = await response.json();

      const make = gptSummary.make || "";
      const model = gptSummary.model || "";
      const year = gptSummary.year || "";
      const driveType = gptSummary.driveType || "";
      let engineType = gptSummary.engine?.trim() || "";

      if (engineType.toUpperCase().includes("L")) {
        const match = engineType.toUpperCase().match(/[^ ]*L/);
        if (match) engineType = match[0];
      }

      if (!make || !model || !year) {
        showError("vin-error", "Invalid vehicle data from VIN.");
        setLoading('vin-search-btn', false);
        return;
      }

      // Show vehicle info
      const infoDiv = document.getElementById("vin-vehicle-info");
      infoDiv.innerHTML = `
        <div style="display: flex; flex-wrap: wrap; gap: 12px; font-size: 14px;">
          <div><strong>Make:</strong> ${make}</div>
          <div><strong>Model:</strong> ${model}</div>
          <div><strong>Year:</strong> ${year}</div>
          <div><strong>DriveType:</strong> ${driveType}</div>
          <div><strong>EngineType:</strong> ${engineType}</div>
          <div><strong>VIN:</strong> ${vin}</div>
        </div>`;
      infoDiv.style.display = 'block';

      // Show and pre-fill editable text input form
      const vinForm = document.getElementById('vin-form');
      vinForm.style.display = 'flex';
      vinForm.style.flexDirection = 'row';
      vinForm.style.gap = '12px'; 
     
      document.getElementById('vin-make').value = make;
      document.getElementById('vin-model').value = model;
      document.getElementById('vin-year').value = year;
      document.getElementById('vin-engine').value = engineType;
      document.getElementById('vin-drive').value = driveType;

    } catch (err) {
      console.error("VIN lookup failed:", err);
      showError("vin-error", "Error fetching data for VIN. Please try again.");
    }

    setLoading('vin-search-btn', false);
  };

  window.handleSearch = async function () {
    clearAllErrors();
    setLoading('ymm-search-btn', true);

    const make = document.getElementById('ymm-make').value.trim().toLowerCase();
  const model = document.getElementById('ymm-model').value.trim().toLowerCase().replace(/\s+/g, '-');
    const year = document.getElementById('ymm-year').value;
    const drive = document.getElementById('ymm-drive').value.trim().toLowerCase();
    const engine = document.getElementById('ymm-engine').value.trim().toLowerCase();
    const defaultCollection = "{{ section.settings.default_collection | default: 'all' }}";

    let hasError = false;
    if (!make) { showError("make-error", "Select make."); hasError = true; }
    if (!model) { showError("model-error", "Select model."); hasError = true; }
    if (!year) { showError("year-error", "Select year."); hasError = true; }

    if (hasError) {
      setLoading('ymm-search-btn', false);
      return;
    }

    let tag = `eps-${make}-${model}`;
    if (drive) tag += `-${drive}`;
    tag += `-${year}`;
    if (engine) tag += `-${engine.replace(/\./g, 'o')}`;

    const exists = await checkProductTagExists(tag);
    if (exists) {
      window.location.href = `/collections/${defaultCollection}/${tag}`;
    } else {
      showError("make-error", "No products found.");
    }

    setLoading('ymm-search-btn', false);
  };
</script>

{% schema %}
{
  "name": "Vehicle Search Filter",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "default_collection",
      "label": "Default Collection",
      "default": "all"
    }
  ]
}
{% endschema %}
